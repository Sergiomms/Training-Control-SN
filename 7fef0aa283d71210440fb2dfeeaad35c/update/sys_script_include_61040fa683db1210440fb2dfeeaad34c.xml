	getInstructorRole: function() {
		var roleG = new GlideRecord("sys_user_has_role");

		roleG.addEncodedQuery("role.name=x_1593185_traini_0.training_instructor");
		roleG.query();

		var instructorUser = [];

		while(roleG.next()) {
			instructorUser.push(roleG.getValue("user"));
		}

		return "sys_idIN" + instructorUser;

	},

    type: 'Instructor_Role'
};]]></script>
