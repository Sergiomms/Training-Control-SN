        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var gtd = new GlideAjax('FutureCoursesFilter');
    gtd.addParam('sysparm_name', 'getAvailableCourses');
    gtd.addParam('sysparm_course', newValue); // Passa o curso selecionado

    gtd.getXMLAnswer(function(response) {
        var availableDates = response.split(','); // Converte a resposta para array

		alert("teste - 0: " + availableDates);

        // Limpa as opções atuais do campo de data
        g_form.clearOptions('training_date'); // Substitua pelo nome correto do campo

        // Limpa qualquer filtro anterior
        g_form.setValue('training_date', ''); // Limpa a seleção atual do campo de data

        // Aplica o filtro ao campo de data baseado no curso selecionado
        g_form.setQuery('training_date', "training_name=" + newValue + " ^training_date>javascript:gs.nowNoTZ()");


		alert("teste - 1: " + "Chegou aqui");


    });



}]]></script>
