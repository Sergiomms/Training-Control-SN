    <sys_script_include action="DELETE">
        <access>package_private</access>
        <active>true</active>
        <api_name>x_1593185_traini_0.AvailableCoursesFilter</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>AvailableCoursesFilter</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var AvailableCoursesFilter = Class.create();
AvailableCoursesFilter.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    initialize: function() {},

    getAvailableCourses: function() {
		
        var userId = this.getParameter('sysparm_user'); // Pega o ID do usuário logado
        
        var allowedTrainings = [];

        // Pega todos os cursos da tabela de agenda de cursos
        var allTrainings = new GlideRecord('x_1593185_traini_0_training_schedule');
        allTrainings.query();

        while (allTrainings.next()) {
            var trainingId = allTrainings.getValue('training_name'); // Pega o ID do curso
            var count = 0;

            // Verifica quantas vezes o usuário fez esse curso com status "Aprovado"
            var enrollment = new GlideRecord('x_1593185_traini_0_training_enrollment');
            enrollment.addQuery('training_name', trainingId);
            enrollment.addQuery('opened_by', userId);
            enrollment.addQuery('state', '3'); // Verifica somente as matrículas aprovadas
            enrollment.query();

            while (enrollment.next()) {
                count++;
            }

            // Se o aluno fez o curso MENOS de 3 vezes, ele ainda pode se matricular
            if (count < 3) {
                allowedTrainings.push(trainingId);
            }
        }

        return 'sys_idIN' + allowedTrainings.join(',');
    },

    type: 'AvailableCoursesFilter'
});]]></script>
