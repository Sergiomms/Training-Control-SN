        <script><![CDATA[function onSubmit() {
    //Type appropriate comment here, and begin script below


    if (g_scratchpad.isFormValidAjax) {
        g_scratchpad.isFormValidAjax = null;
        return true;
    }


    g_scratchpad.isFormValidAjax = false;

    // ==========================================================================================================
    var selectedTraining = g_form.getValue('training_name'); // Pega o curso selecionado
    var selectedDate = g_form.getValue('training_date'); // Pega a data escolhida

    var ga = new GlideAjax('CheckDuplicateEnrollment'); // Chamamos o Script Include
    ga.addParam('sysparm_name', 'checkEnrollment');
    ga.addParam('sysparm_training', selectedTraining); // Envia o curso selecionado
    ga.addParam('sysparm_date', selectedDate); // Envia a data selecionada
    ga.addParam('sysparm_user', g_user.userID); // Pega o ID do usuário logado
    // ==========================================================================================================


    ga.getXMLAnswer(setAnswer);
    return false;

    function setAnswer(answer) {
        if (answer) {
            if (answer == 'duplicate') {
                alert("⚠️ Você já está matriculado neste curso para esta data! Escolha outra data/ Curso.");
				g_form.addErrorMessage("You can't select future dates.");
                return false;
            } else {
                var actionName = g_form.getActionName();
                g_scratchpad.isFormValidAjax = true;
                g_form.submit(actionName);
            }
        }
    }



