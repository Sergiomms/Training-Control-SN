        <name>SendInstructorReport</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var SendInstructorReport = Class.create();
SendInstructorReport.prototype = {
    initialize: function() {},

    sendReport: function(trainingID) {
        // var email = new GlideEmailOutbound();
		var instructorId = '';
        var instructorEmail = "";
        var trainingNameId = "";
		var trainingName = "";
        var trainingDate = "";
        var studentList = [];

        // Buscar o curso
        var training = new GlideRecord('x_1593185_traini_0_training_schedule');
        if (training.get(trainingID)) {
            instructorId = training.getValue('instructor'); // Pega o id do instrutor
            trainingNameId = training.getValue('training_name');
            trainingDate = training.getValue('training_date');
        }

		

		// pega o nome do treinamento
		var trainingTable = new GlideRecord('x_1593185_traini_0_training');
		trainingTable.get(trainingNameId);
		trainingName = trainingTable.getValue('training_name');

		// Pega o email do instrutor
        var sysUserId = new GlideRecord('sys_user');
        sysUserId.get(instructorId);
        instructorEmail = sysUserId.getValue('email');


        // Buscar alunos matriculados com status "Aprovado" ou "Aguardando Aprovação"
        var enrollment = new GlideRecord('x_1593185_traini_0_training_enrollment');
		enrollment.addEncodedQuery('state=2^ORstate=3^training_name=' + trainingNameId);
        enrollment.query();

		// var teste = "";
        while (enrollment.next()) {
            studentList.push(enrollment.getValue('opened_by'));
        }

        // Se houver alunos elegíveis, enviar e-mail
        if (studentList.length > 0 && instructorEmail) {
            var subject = "Relatório de Alunos Matriculados - " + trainingName;
            var body = "Olá, segue a lista de alunos matriculados no curso: <br><br>" +
                "<b>Curso:</b> " + trainingName + "<br>" +
                "<b>Data:</b> " + trainingDate + "<br><br>" +
                "<b>Alunos Matriculados:</b><br>" +
                studentList.join("<br>") + "<br><br>" +
                "Atenciosamente,<br>Equipe de Treinamentos";

            // email.setSubject(subject);
            // email.setBody(body);
            // email.setFrom("training@aoop.com.br");
            // email.addRecipient("to", instructorEmail);
            // email.save();
			
			gs.info(studentList.join(","));

            return "E-mail enviado com sucesso para " + instructorEmail;
        } else {
            return "Nenhum aluno matriculado ou e-mail do instrutor não encontrado.";
        }
    },

    type: 'SendInstructorReport'
};]]></script>
