        <name>AvailableCoursesFilter</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) {
        return;
    }

    //Type appropriate comment here, and begin script below
    var userId = g_user.userID; // Pega o ID do usuário logado

    var ga = new GlideAjax('AvailableCoursesFilter'); // Nome do Script Include
    ga.addParam('sysparm_name', 'getAvailableCourses'); // Método a ser chamado
    ga.addParam('sysparm_user', userId); // Enviar o ID do usuário
    ga.getXMLAnswer(function(response) {
        var availableCourses = response; // Retorna 'sys_idINxxxx,yyyy,zzzz'

        // Atualiza a variável de cursos no formulário
        g_form.setValue('training_name', ''); // Reseta a seleção
        g_form.setReadOnly('training_name', false); // Libera o campo

        // Aplica o filtro dinamicamente
        g_form.setFilter('training_name', availableCourses);
    });

}]]></script>
